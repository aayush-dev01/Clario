# Database (Supabase or any PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/post-auth
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/post-auth

# Socket server
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
SOCKET_SERVER_INTERNAL_URL=http://localhost:4000
SOCKET_SERVER_SECRET=change-me
NEXT_INTERNAL_TRPC_URL=http://localhost:3000/api/trpc

# Pusher realtime signaling (optional if using socket fallback)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# WebRTC TURN / ICE (optional but recommended for production)
METERED_DOMAIN=
METERED_SECRET_KEY=
TURN_SERVER_URL=
TURN_SERVER_URLS=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
NEXT_PUBLIC_TURN_SERVER_URL=
NEXT_PUBLIC_TURN_SERVER_URLS=
NEXT_PUBLIC_TURN_SERVER_USERNAME=
NEXT_PUBLIC_TURN_SERVER_CREDENTIAL=

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
